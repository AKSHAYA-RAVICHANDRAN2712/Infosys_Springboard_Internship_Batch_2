# Copy this file to .env and adjust if your local Postgres differs.
# These defaults match the MediSphere docker-compose / pgAdmin setup
# (database name "medisphere", default postgres superuser).

PORT=4001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=medisphere
DB_USER=postgres
DB_PASSWORD=postgres

# Comma separated list of origins allowed to call this API.
# 5177 is the Milestone 4 frontend's Vite dev port (see vite.config.js).
CORS_ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
